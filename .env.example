# ===================================================
# PULSE_BLEND_MEDIA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development.
# IMPORTANT: NEVER commit real production secrets to version control!
# ===================================================

# Application Details
VITE_APP_NAME=Pulse_Blend_Media
VITE_APP_URL=http://localhost:5173

# Backend API Configuration (Use full URL or proxy path)
VITE_API_BASE_URL=http://localhost:5000/api

# Owner Contact Details
VITE_WHATSAPP_NUMBER=+91 6304834605
VITE_WHATSAPP_WEBHOOK_URL=

# Supabase Integration (Cloud / Online Supabase project settings)
# Obtain these values from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-Side Only Secrets (Do NOT prefix with VITE_, backend server use only)
# SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph & Excel Server Configuration (Secrets - Server Side Only)
# MICROSOFT_TENANT_ID=your-tenant-id-guid
# MICROSOFT_CLIENT_ID=your-client-id-guid
# MICROSOFT_CLIENT_SECRET=your-client-secret-value
# EXCEL_DRIVE_ID=your-onedrive-drive-id-optional
# EXCEL_WORKBOOK_ID=your-excel-file-item-id
# EXCEL_WORKSHEET_NAME=Bookings
# EXCEL_TABLE_NAME=BookingsTable


